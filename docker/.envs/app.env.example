# App config. Copy to docker/.envs/app.env (make env). Tags: [restart] needs a container restart.
# Swap any driver by changing one line — like Laravel's .env.

# ---- app [restart]
APP_NAME=Pathya
APP_ENV=production            # local | production | testing
APP_LOCALE=en                 # default response language: en | bn
APP_URL=http://127.0.0.1:8100 # public base URL (robots.txt, sitemap.xml, canonical links)
CORS_ORIGINS=                 # comma list; empty = same-origin only needs none
WEB_ROOT=/app/public

# ---- database [restart] (docker-commons; filled by make db)
DB_HOST=common-postgres
DB_PORT=5432
DB_NAME=food
DB_USER=food
DB_PASSWORD=
DB_SSLMODE=disable
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true          # apply pending migrations on boot
DB_AUTO_SEED=true             # seed the catalog when empty

# ---- cache [restart]
CACHE_DRIVER=memory           # memory | redis | null
CACHE_TTL=600                 # seconds; admin writes flush instantly
CACHE_PREFIX=food:
REDIS_URL=redis://common-redis-1:6379/3

# ---- log [restart]
LOG_CHANNEL=stdout            # stdout | file | stack
LOG_FORMAT=json               # json | pretty
LOG_LEVEL=info                # EnvFilter syntax, e.g. info,food_api=debug
LOG_PATH=/app/storage/logs/app.log

# ---- storage [restart] (media library files)
STORAGE_DISK=s3               # s3 | local
STORAGE_ROOT=/app/storage/app # local disk root
STORAGE_URL=/storage
# S3-compatible store; docker-commons MinIO by default (filled by make s3)
S3_ENDPOINT=http://common-minio:9000
S3_REGION=us-east-1
S3_BUCKET=food-media
S3_ACCESS_KEY=food
S3_SECRET_KEY=
S3_PATH_STYLE=true

# ---- admin [restart]
ADMIN_TOKEN=                  # >= 16 chars; empty disables /api/v1/admin (make env generates one)

# Pixabay API key (free, pixabay.com/api/docs): only for `make images`, which fetches transparent food PNGs into the media library
PIXABAY_KEY=

# Sign-in: session length (days), Secure cookie flag (keep true; browsers accept it on localhost), mail driver for password resets (log = written to the app log)
SESSION_DAYS=30
COOKIE_SECURE=true
MAIL_DRIVER=log

# 64 hex characters (32 bytes): encrypts payment-gateway secrets at rest. make env creates it. Changing it makes saved secrets unreadable.
APP_KEY=

# External sync (admin > System > External sync): sources are fetched over http(s) only and never from loopback, link-local or private
# addresses (checked after DNS). true lets a source reach them, for a local mock endpoint while developing. Keep false anywhere real.
SYNC_ALLOW_PRIVATE_HOSTS=false
